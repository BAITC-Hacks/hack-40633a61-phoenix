# Скопируйте в .env и заполните при необходимости (.env уже в .gitignore).
# Всё приложение полностью работает и без этих переменных — LLM-ассистент
# опционален. Без OPENAI_API_KEY эндпоинт POST /api/ai/ask вернёт понятную
# ошибку 503 "AI-ассистент не настроен", остальной дашборд не пострадает.

# Настоящий секретный API key (обычно начинается с sk-...). URL проекта
# platform.openai.com/p/... НЕ является ключом. Храните секрет только в .env.
OPENAI_API_KEY=

# Базовый URL API. По умолчанию — OpenAI. Можно указать любой совместимый
# эндпоинт (OpenRouter, локальный vLLM/Ollama с OpenAI-адаптером и т.п.).
OPENAI_BASE_URL=https://api.openai.com/v1

# Модель для Chat Completions.
OPENAI_MODEL=gpt-4o-mini

# Таймаут запроса к LLM API, секунд.
AI_REQUEST_TIMEOUT_S=30

# CORS для локальной разработки (через запятую). "*" — разрешить всё (по
# умолчанию; годится для локального демо, не для продакшена).
CORS_ORIGINS=*

# Пути переопределять обычно не нужно — по умолчанию data/ и out/ в корне репозитория.
# MONEYGRAPH_DATA_DIR=data
# MONEYGRAPH_OUT_DIR=out
# MONEYGRAPH_FRONTEND_DIR=frontend/dist
# MONEYGRAPH_RUNS_DIR=runs

# Backward-compatible aliases: AI_API_KEY, AI_API_BASE_URL, AI_MODEL.
